{
  // Cloudflare Worker: static PWA assets + /api (Hono) + D1.
  // `database_id` is the real remote D1 database. Local dev and tests use an in-memory D1 and ignore it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pundo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Access. Both must be set for the API to answer (it fails closed otherwise).
  //   ACCESS_TEAM_DOMAIN: Zero Trust -> Settings -> General -> Team domain, e.g. "myteam.cloudflareaccess.com"
  //   ACCESS_AUD:         Zero Trust -> Access -> Applications -> your app -> Overview -> Application Audience (AUD) Tag
  // Local dev bypass is NOT configured here on purpose: use `npm run worker:dev` (passes --var ACCESS_DEV_BYPASS:true).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "lingering-dew-04bc.cloudflareaccess.com",
    "ACCESS_AUD": "b92e71f7f384ddbececcc2a5cb66ca571bcd3f09c5ebdd8f68af1907633abeba"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pundo",
      "database_id": "85054d03-d16a-4276-85b5-b2e95b62d91a",
      "migrations_dir": "migrations"
    }
  ]
}
